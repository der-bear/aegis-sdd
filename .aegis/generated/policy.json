  "risk_tiers": {
    "A": {
      "description": "irreversible or authority-bearing; builder is never final reviewer",
      "independent_reviewer": true,
      "match_change_kinds": [
        "auth",
        "data-migration",
        "money",
        "concurrency"
      ],
      "review_rounds": 2
    },
    "B": {
      "description": "standard feature work behind a contract",
      "independent_reviewer": true,
      "match_change_kinds": [
        "route",
        "contract",
        "cross-module",
        "dependency"
      ],
      "review_rounds": 1
    },
    "C": {
      "description": "mechanical; batched review is acceptable",
      "independent_reviewer": false,
      "match_change_kinds": [
        "code",
        "docs",
        "test"
      ],
      "review_rounds": 1
    }
  },
  "self_governance": [
    "retro"
  ],
  "testing_mandate": "tests-with-code"
