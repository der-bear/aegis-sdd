{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis diagram registry",
  "description": "Maps each diagram to the code it describes. `watches` is what makes staleness detectable: the gate hashes those sources and compares against verified_source_digest, so nobody can turn a check green by editing a date.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "kind", "path", "watches", "generated", "origin"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "kind": {
        "enum": ["context-diagram", "container-diagram", "erd", "sequence-critical", "state-machine",
                 "dataflow", "lineage", "api-reference", "schema-registry", "usage-examples",
                 "narrative", "record"]
      },
      "path": { "type": "string" },
      "watches": { "type": "array", "items": { "type": "string" }, "minItems": 1,
                   "description": "globs whose content the diagram claims to describe" },
      "generated": { "type": "boolean", "description": "true means a command regenerates it; the gate requires the result to be diff-clean" },
      "generator": { "type": "string" },
      "origin": { "type": "string", "pattern": "^(TASK|RETRO|ADR|LEGACY)-" },
      "owner": { "type": "string" },
      "verified_source_digest": { "type": "string" },
      "verified_at": { "type": "string", "format": "date" },
      "verified_by": { "type": "string", "minLength": 2, "description": "who claims this diagram matches its sources" },
      "verified_note": { "type": "string" },
      "status": { "enum": ["proposed", "active", "deprecated"] },
      "superseded_by": { "type": "string" }
    },
    "additionalProperties": false
  }
}
