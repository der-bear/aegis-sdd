{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis environment registry",
  "description": "Every variable the code reads. `example` never holds a real value — a registry that leaks secrets is worse than no registry.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "status", "origin", "required", "scope"],
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "status": { "enum": ["proposed", "active", "deprecated"] },
      "origin": { "type": "string", "pattern": "^(TASK|RETRO|ADR|LEGACY)-" },
      "required": { "type": "boolean" },
      "secret": { "type": "boolean" },
      "scope": { "enum": ["runtime", "build", "test", "ci", "local"] },
      "description": { "type": "string" },
      "example": { "type": "string", "description": "placeholder only; must not be a working value" },
      "default": { "type": "string" },
      "docs": { "type": "string" },
      "superseded_by": { "type": "string" },
      "verified": { "enum": ["confirmed", "observed", "unverified"] }
    },
    "additionalProperties": false
  }
}
